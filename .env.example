# Database - REQUIRED for Vercel deploy
# Use a free MySQL from PlanetScale, Turso, or Railway
DATABASE_URL=mysql://user:password@host:3306/mnil_ink

# JWT Secret - REQUIRED
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-this

# Optional: Your email for the first admin user
# Owner will be the first user created with this email
OWNER_EMAIL=
